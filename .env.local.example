# Copy to .env.local and fill in.
# Required only for the adversarial LLM runner (AdversarySimulator).
OPENAI_API_KEY=sk-...

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# URANUS_BRIDGE_PORT=3223
# URANUS_TIMEOUT_MS=120000

# For the browser to reach the bridge in production, override to the deployed URL.
# NEXT_PUBLIC_URANUS_BRIDGE_URL=http://localhost:3223
